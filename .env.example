# Copy this file to .env and replace generated values and optional API credentials.
# .env is ignored by Git and must never be committed.

PAYSHIELD_ENV=development
PAYSHIELD_DB_PATH=data/payshield.db
PAYSHIELD_ADMIN_TOKEN=
PAYSHIELD_MERCHANT_API_KEY=replace-with-a-long-random-value
PAYSHIELD_APP_URL=http://localhost:8000
PAYSHIELD_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional URL threat intelligence. DNS and TLS checks work without this key.
GOOGLE_WEB_RISK_API_KEY=

# Optional until Stripe recurring billing is configured.
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
